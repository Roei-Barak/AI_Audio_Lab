<Window x:Class="KaraokeStudio.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:KaraokeStudio.WPF.Views.Pages"
        Title="🎤 KaraokeStudio"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1E1E1E"
        FlowDirection="RightToLeft"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background"  Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header / status -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Backend log (collapsible) -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Background="#252526" Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🎤 KaraokeStudio"
                       FontSize="18" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="16,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="StatusDot" Color="#FF5555"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="BackendStatusText"
                           Text="{Binding BackendStatus}"
                           Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="📋 log" Width="50" Height="22" Margin="12,0,0,0"
                        Background="Transparent" Foreground="#888" BorderThickness="0"
                        FontSize="11" Click="LogToggle_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Tab pages ── -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}"
                    Background="#1E1E1E" BorderThickness="0">

            <TabItem Header="⚡ Pipeline">
                <pages:PipelinePage DataContext="{Binding Pipeline}"/>
            </TabItem>

            <TabItem Header="📝 עורך כתוביות">
                <pages:SubtitleEditorPage x:Name="EditorPage"
                                          DataContext="{Binding Editor}"/>
            </TabItem>

            <TabItem Header="🎭 פרודיה">
                <pages:ParodyPage DataContext="{Binding Parody}"/>
            </TabItem>

            <TabItem Header="📚 Batch">
                <pages:BatchPage DataContext="{Binding Batch}"/>
            </TabItem>

            <TabItem Header="📟 Backend Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#111">
                    <TextBlock Text="{Binding BackendLog}"
                               Foreground="#88FF88" FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap" Padding="8" FlowDirection="LeftToRight"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── Collapsible backend log strip ── -->
        <Expander Grid.Row="2" x:Name="LogExpander"
                  Header="Backend Output" IsExpanded="False"
                  Background="#111" Foreground="#888" BorderBrush="#333"
                  MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding BackendLog}"
                           Foreground="#55AA55" FontFamily="Consolas" FontSize="10"
                           Padding="8" FlowDirection="LeftToRight"/>
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
