<UserControl x:Class="KaraokeStudio.WPF.Views.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="140" Background="#1E1E1E"
             Cursor="Cross">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>  <!-- Waveform -->
            <RowDefinition Height="60"/>  <!-- Subtitle bars -->
            <RowDefinition Height="20"/>  <!-- Time ruler -->
        </Grid.RowDefinitions>

        <!-- Waveform layer -->
        <Canvas x:Name="WaveformCanvas" Grid.Row="0" ClipToBounds="True"
                Background="#2D2D2D"/>

        <!-- Subtitle bars layer -->
        <Canvas x:Name="TimelineCanvas" Grid.Row="1" ClipToBounds="True"
                Background="#252526"
                MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                MouseMove="TimelineCanvas_MouseMove"
                MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                MouseWheel="TimelineCanvas_MouseWheel"
                MouseRightButtonDown="TimelineCanvas_MouseRightButtonDown"/>

        <!-- Playhead drawn on top of both rows — spans waveform + bars -->
        <Canvas x:Name="PlayheadCanvas" Grid.Row="0" Grid.RowSpan="2"
                IsHitTestVisible="False"/>

        <!-- Time ruler -->
        <Canvas x:Name="RulerCanvas" Grid.Row="2" Background="#333337"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
