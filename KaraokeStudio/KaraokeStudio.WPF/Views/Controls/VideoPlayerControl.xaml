<UserControl x:Class="KaraokeStudio.WPF.Views.Controls.VideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black" MinHeight="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video surface -->
        <vlc:VideoView x:Name="VideoView" Grid.Row="0"/>

        <!-- Subtitle overlay -->
        <TextBlock x:Name="SubtitleOverlay" Grid.Row="0"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="10,0,10,20"
                   TextAlignment="Center"
                   FontSize="22" FontWeight="Bold"
                   Foreground="White"
                   TextWrapping="Wrap"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- No-video placeholder -->
        <TextBlock x:Name="Placeholder" Grid.Row="0"
                   Text="📹 לא נטען סרטון" Foreground="#555" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Controls bar -->
        <Grid Grid.Row="1" Background="#222" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPlayPause" Grid.Column="0"
                    Content="▶" Width="38" Height="30"
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    FontSize="14" Margin="4,2"
                    Click="BtnPlayPause_Click"/>

            <Slider x:Name="SeekBar" Grid.Column="1"
                    Minimum="0" Maximum="1" Value="0"
                    VerticalAlignment="Center" Margin="4,0"
                    IsMoveToPointEnabled="True"
                    PreviewMouseDown="SeekBar_PreviewMouseDown"
                    PreviewMouseUp="SeekBar_PreviewMouseUp"
                    ValueChanged="SeekBar_ValueChanged"/>

            <TextBlock x:Name="TimeLabel" Grid.Column="2"
                       Text="0:00 / 0:00" Foreground="#CCC" FontSize="11"
                       VerticalAlignment="Center" Margin="4,0"/>

            <Slider x:Name="VolumeSlider" Grid.Column="3"
                    Minimum="0" Maximum="100" Value="80"
                    VerticalAlignment="Center" Margin="4,0"
                    ToolTip="עוצמת שמע"
                    ValueChanged="VolumeSlider_ValueChanged"/>
        </Grid>
    </Grid>
</UserControl>
