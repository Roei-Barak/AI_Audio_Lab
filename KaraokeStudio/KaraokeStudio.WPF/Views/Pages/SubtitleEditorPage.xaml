<UserControl x:Class="KaraokeStudio.WPF.Views.Pages.SubtitleEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:KaraokeStudio.WPF.Views.Controls"
             xmlns:conv="clr-namespace:KaraokeStudio.WPF.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:TimeSpanConverter      x:Key="TimeSpanConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStringConverter  x:Key="BoolToStr"/>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ── Toolbar ── -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4">
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadAssAsyncCommand}" Content="📂 טען ASS"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding SaveAsyncCommand}" Content="💾 שמור"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding ExportSrtAsyncCommand}" Content="📄 ייצא SRT"/>
            <Separator/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding UndoCommand}" Content="↩ Undo"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding RedoCommand}" Content="↪ Redo"/>
            <Separator/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding SplitAtPlayheadCommand}" Content="✂ פצל"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding MergeSelectedCommand}" Content="🔗 מזג"/>
            <Separator/>
            <!-- Search/Replace row -->
            <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="Gray" Margin="4,0"/>
            <TextBox Width="120" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="→" VerticalAlignment="Center" Foreground="Gray" Margin="4,0"/>
            <TextBox Width="120" Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}"
                     Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                     VerticalContentAlignment="Center"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding FindReplaceCommand}" Content="החלף"/>
            <Separator/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadVideoCommand}" Content="🎬 וידאו"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadAudioAsyncCommand}" Content="🎵 אודיו"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding RenderAsyncCommand}"
                    IsEnabled="{Binding IsRendering, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                    Content="🚀 רנדר"/>
        </ToolBar>

        <!-- ── Status bar ── -->
        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC">
            <TextBlock Text="{Binding StatusText}" Foreground="White" Margin="8,0"/>
            <Separator/>
            <TextBlock Text="{Binding Lines.Count, StringFormat='שורות: {0}'}" Foreground="White" Margin="8,0"/>
            <ProgressBar IsIndeterminate="{Binding IsRendering}"
                         Width="120" Height="12" Margin="8,0"
                         Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}"/>
        </StatusBar>

        <!-- ── Timeline (bottom) ── -->
        <ctrl:TimelineControl
            x:Name="Timeline"
            DockPanel.Dock="Bottom"
            Height="140"
            Lines="{Binding Lines}"
            PlayheadPosition="{Binding PlayheadPosition}"
            WaveformSamples="{Binding WaveformSamples}"
            SelectedLine="{Binding SelectedLine, Mode=TwoWay}"/>

        <!-- ── Main content: Video + DataGrid ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Video player -->
            <ctrl:VideoPlayerControl x:Name="Player" Grid.Column="0"
                                     Background="Black"/>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#333"/>

            <!-- Subtitle DataGrid -->
            <DataGrid x:Name="SubGrid" Grid.Column="2"
                      ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="#1E1E1E" Foreground="White"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="30"/>
                    <DataGridTextColumn Header="התחלה"
                                        Binding="{Binding Start, Converter={StaticResource TimeSpanConv}}"
                                        Width="70"/>
                    <DataGridTextColumn Header="סיום"
                                        Binding="{Binding End, Converter={StaticResource TimeSpanConv}}"
                                        Width="70"/>
                    <DataGridTextColumn Header="טקסט"
                                        Binding="{Binding Text}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#3D4A1A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
