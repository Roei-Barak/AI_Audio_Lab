<UserControl x:Class="KaraokeStudio.WPF.Views.Pages.PipelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KaraokeStudio.WPF.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStringConverter    x:Key="BoolToStr"/>
        <Style TargetType="CheckBox" x:Key="ChkStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="⚡ Pipeline — יוצר קריוקי מלא מ-URL" FontSize="18"
                       Foreground="White" Margin="0,0,0,12"/>

            <!-- URL input -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="URL:" Style="{StaticResource Label}" Width="60"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                         Padding="6,4" FontSize="13"
                         FlowDirection="LeftToRight"/>
            </Grid>

            <!-- Lang + Options -->
            <WrapPanel Margin="0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="שפה:" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="LangBox" Width="100"
                              SelectedValue="{Binding Lang}"
                              SelectedValuePath="Tag"
                              Background="#3C3C3C" Foreground="White">
                        <ComboBoxItem Content="עברית"   Tag="he" IsSelected="True"/>
                        <ComboBoxItem Content="אנגלית"  Tag="en"/>
                        <ComboBoxItem Content="ערבית"   Tag="ar"/>
                        <ComboBoxItem Content="רוסית"   Tag="ru"/>
                        <ComboBoxItem Content="ספרדית"  Tag="es"/>
                        <ComboBoxItem Content="אוטומטי" Tag="auto"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox Style="{StaticResource ChkStyle}" Margin="0,0,16,0"
                          IsChecked="{Binding Save4Stems}" Content="4 stems"/>
                <CheckBox Style="{StaticResource ChkStyle}" Margin="0,0,16,0"
                          IsChecked="{Binding UseBidi}" Content="BiDi RTL"/>
                <CheckBox Style="{StaticResource ChkStyle}"
                          IsChecked="{Binding ForceReprocess}" Content="Force"/>
            </WrapPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,8">
                <Button Content="{Binding IsRunning, Converter={StaticResource BoolToStr}, ConverterParameter='⏹ עצור|▶ התחל'}"
                        Command="{Binding StartAsyncCommand}"
                        Width="120" Height="36"
                        Background="#007ACC" Foreground="White"
                        BorderThickness="0" FontSize="14"/>
                <Button Content="ביטול" Command="{Binding CancelCommand}"
                        Width="80" Height="36" Margin="8,0,0,0"
                        Background="#8B0000" Foreground="White"
                        BorderThickness="0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Progress -->
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"
                         Margin="0,8,0,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="#AAA" FontSize="11"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Output video link -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding OutputVideoPath}"
                   Foreground="#4FC3F7" FontSize="12"
                   Margin="0,0,0,8"
                   Visibility="{Binding OutputVideoPath, Converter={StaticResource BoolToVis}}"
                   TextDecorations="Underline"
                   Cursor="Hand"/>

        <!-- Logs -->
        <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto"
                      Background="#1A1A1A" x:Name="LogScroll">
            <ItemsControl ItemsSource="{Binding Logs}" x:Name="LogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#DDD" FontSize="11"
                                   FontFamily="Consolas" Padding="4,1"
                                   FlowDirection="LeftToRight"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
