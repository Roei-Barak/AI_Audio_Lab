<UserControl x:Class="KaraokeStudio.WPF.Views.Pages.BatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KaraokeStudio.WPF.Converters"
             xmlns:models="clr-namespace:KaraokeStudio.WPF.Models"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStringConverter    x:Key="BoolToStr"/>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="360" Height="28"
                         Text="{Binding NewQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                         Padding="6,4" FontSize="13" FlowDirection="LeftToRight"
                         ToolTip="הזן URL של YouTube">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddJobCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Style="{StaticResource ToolBtn}"
                        Command="{Binding AddJobCommand}" Content="➕ הוסף" Margin="4,0"/>
            </StackPanel>
            <Separator/>
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="שפה:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="80" SelectedValue="{Binding Lang}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="עברית"  Tag="he" IsSelected="True"/>
                    <ComboBoxItem Content="אנגלית" Tag="en"/>
                    <ComboBoxItem Content="אוטומטי" Tag="auto"/>
                </ComboBox>
            </StackPanel>
            <CheckBox Foreground="White" IsChecked="{Binding Save4Stems}" Content="4 stems" Margin="4,0"/>
            <CheckBox Foreground="White" IsChecked="{Binding UseBidi}"    Content="BiDi"    Margin="4,0"/>
            <CheckBox Foreground="White" IsChecked="{Binding ForceReprocess}" Content="Force" Margin="4,0"/>
            <Separator/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding StartAllAsyncCommand}"
                    Background="#007ACC"
                    Content="{Binding IsRunning, Converter={StaticResource BoolToStr}, ConverterParameter='⏳ מעבד...|▶ הפעל הכל'}"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding CancelCommand}"
                    Background="#8B0000"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    Content="⏹ עצור"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding ClearAllCommand}" Content="🗑 נקה"/>
        </ToolBar>

        <!-- Job list -->
        <ListView ItemsSource="{Binding Jobs}"
                  Background="#1E1E1E"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="שיר / URL" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Query}" Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           FlowDirection="LeftToRight" ToolTip="{Binding Query}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="סטטוס" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="White"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="התקדמות" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding Progress}" Maximum="100"
                                             Height="12" Width="130"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="זמן" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Elapsed, StringFormat=hh\\:mm\\:ss}"
                                           Foreground="#CCC" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="פלט" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OutputPath}" Foreground="#4FC3F7"
                                           TextTrimming="CharacterEllipsis" FontSize="11"
                                           FlowDirection="LeftToRight"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Width="28" Height="22"
                                        Background="Transparent" Foreground="#F44336"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RemoveJobCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}"
                                     Value="{x:Static models:JobStatus.Done}">
                            <Setter Property="Background" Value="#1B3A1B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}"
                                     Value="{x:Static models:JobStatus.Failed}">
                            <Setter Property="Background" Value="#3A1B1B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}"
                                     Value="{x:Static models:JobStatus.Running}">
                            <Setter Property="Background" Value="#1B2D3A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
