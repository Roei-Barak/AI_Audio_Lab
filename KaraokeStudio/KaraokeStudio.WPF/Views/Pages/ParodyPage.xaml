<UserControl x:Class="KaraokeStudio.WPF.Views.Pages.ParodyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KaraokeStudio.WPF.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:TimeSpanConverter         x:Key="TimeSpanConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Background"      Value="#3C3C3C"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Background="#2D2D2D" Padding="4">
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadAssCommand}" Content="📂 טען ASS"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadVideoCommand}" Content="🎬 וידאו"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding LoadAudioCommand}" Content="🎵 אודיו"/>
            <Separator/>
            <CheckBox Foreground="White" IsChecked="{Binding UseAlternative}"
                      Content="השתמש בחלופי" VerticalAlignment="Center" Margin="4,0"/>
            <CheckBox Foreground="White" IsChecked="{Binding UseBidi}"
                      Content="BiDi" VerticalAlignment="Center" Margin="4,0"/>
            <Separator/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding ExportAsyncCommand}" Content="📄 ייצא ASS"/>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding RenderAsyncCommand}"
                    IsEnabled="{Binding IsRendering, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                    Content="🚀 רנדר פרודיה"/>
        </ToolBar>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#2D2D2D">
            <TextBlock Text="{Binding StatusText}" Foreground="White" Margin="8,0"/>
            <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="8,0"
                         Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}"/>
        </StatusBar>

        <!-- Info panel -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="📁 ASS: " Foreground="#AAA" FontSize="11"/>
            <TextBlock Text="{Binding AssFilePath, FallbackValue='—'}" Foreground="#4FC3F7" FontSize="11"/>
            <TextBlock Text="   🎬 " Foreground="#AAA" FontSize="11"/>
            <TextBlock Text="{Binding VideoFilePath, FallbackValue='—'}" Foreground="#4FC3F7" FontSize="11"/>
        </StackPanel>

        <!-- Lines DataGrid -->
        <DataGrid ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#1E1E1E" Foreground="White"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="התחלה"
                                    Binding="{Binding Start, Converter={StaticResource TimeSpanConv}}"
                                    Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="סיום"
                                    Binding="{Binding End, Converter={StaticResource TimeSpanConv}}"
                                    Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="מקור"
                                    Binding="{Binding Text}"
                                    Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FlowDirection"  Value="RightToLeft"/>
                            <Setter Property="TextWrapping"   Value="Wrap"/>
                            <Setter Property="Foreground"     Value="#BBB"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="חלופי (פרודיה)"
                                    Binding="{Binding AltText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FlowDirection" Value="RightToLeft"/>
                            <Setter Property="TextWrapping"  Value="Wrap"/>
                            <Setter Property="Foreground"    Value="#FFD54F"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="FlowDirection"  Value="RightToLeft"/>
                            <Setter Property="Background"     Value="#2D2D2D"/>
                            <Setter Property="Foreground"     Value="White"/>
                            <Setter Property="BorderBrush"    Value="#007ACC"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
