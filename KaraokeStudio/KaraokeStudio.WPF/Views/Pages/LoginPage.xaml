<Page x:Class="KaraokeStudio.WPF.Views.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="כניסה"
      FlowDirection="RightToLeft">

    <Grid Background="#1E1E1E">
        <Border MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#252526" CornerRadius="10" Padding="32,28">
            <StackPanel>

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#007ACC" CornerRadius="14"
                            Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🎤" FontSize="30"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KaraokeStudio" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="כניסה למערכת" FontSize="12"
                               Foreground="#9D9D9D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Server URL -->
                <TextBlock Text="כתובת שרת" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtServer" FlowDirection="LeftToRight" Margin="0,0,0,12"
                         Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Username -->
                <TextBlock Text="שם משתמש" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtUser" FlowDirection="LeftToRight" Margin="0,0,0,12"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="סיסמה" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PwdBox" Margin="0,0,0,16"/>

                <!-- Error -->
                <Border x:Name="ErrBorder" Visibility="Collapsed"
                        Background="#3F0000" BorderBrush="#C00" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtError" Foreground="#FF6666" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Button Content="{Binding BtnText}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PwdBox}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
